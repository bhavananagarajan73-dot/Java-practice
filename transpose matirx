import java.util.Scanner;
public class Main{
public static void main(String[]args){
Scanne sc=new Scanner(System.in);
int r=sc.nextInt();
int c=sc.nextInt();
int mat[][]=new int[r][c];
for(int i=0;i<r;i++){
for(int j=0;j<c;j++){
mat[i][j]=sc.nextInt();
}
}
tranpose(r,c,mat);
}
static void tranpose(int r,int c,int mat[][]){
for(int j=0;j<c;j++){
for(int i=0;i<r;i++){
System.out.print(mat[i][j]+" ");
}
System.out.println();
}
}
}
