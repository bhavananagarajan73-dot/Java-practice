import java.util.Scanner;
public class Main{
public static void main(String[]args){
Scanner sc=new Scanner(System.in);
int n=sc.nextInt();
int arr[]=new int[n];
for(int i=0;i<n;i++){
for(int j=0;j<n;j++){
arr[i]=sc.nextInt();
}
}
tranpose(n,arr);
}
static void tranpose(int n,int arr[]){
for(int j=0;j<n;j++{
for(int i=0;i<n;i++){
System.out.print(arr[i][j]+" ");
}
}
}
